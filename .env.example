# Clinical Placements Database — environment variables
#
# This file is the authoritative list. Copy it to .env.local for local
# development; for production, set the same variables in the Vercel dashboard.
# Never commit .env or .env.local — .gitignore already excludes them.

# ===================
# DATABASE (required)
# ===================
# Supabase PostgreSQL connection string. The app connects with the `pg` driver
# directly — it does not use supabase-js, so no SUPABASE_URL / ANON_KEY /
# SERVICE_ROLE_KEY is needed here. (The GitHub Actions keepalive workflow uses
# SUPABASE_URL and SUPABASE_ANON_KEY, but those are repo secrets, not app env.)
#
# Get from: Supabase Dashboard > Settings > Database > Connection string (URI)
#
# NOTE: if this is unset the app silently falls back to localhost:5432 rather
# than failing loudly (see src/lib/db.ts). If nothing loads and every query
# errors, check this first.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ===================
# AI CHATBOT (required for /api/chat)
# ===================
# Anthropic API key. This is billed per request and the chat endpoint is
# publicly reachable — see docs/OPERATIONS.md.
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ===================
# API SECURITY
# ===================
# Generate with: openssl rand -base64 32
#
# WARNING: these two must hold the SAME value for the check to pass, and
# NEXT_PUBLIC_ means the value is compiled into the browser bundle where anyone
# can read it. This pair therefore provides no real protection — it only stops
# casual scripted access. Documented in docs/OPERATIONS.md under Known Issues.
INTERNAL_API_SECRET=your-secret-key-here
NEXT_PUBLIC_API_SECRET=your-secret-key-here

# Comma-separated origin allowlist for /api/chat.
# Add your Vercel domain for production.
ALLOWED_DOMAINS=localhost,127.0.0.1,your-app.vercel.app

# ===================
# DATA IMPORT (scripts/ only — not needed to run the app)
# ===================
# Bureau of Economic Analysis key, used by scripts/import_state_economic.py
# for the annual GDP refresh. See docs/DATA_PIPELINE.md.
# Get from: https://apps.bea.gov/API/signup/
BEA_API_KEY=your-bea-key-here
